# ===================================================================
# 3D Print CAD Assistant - Environment Configuration Template
# ===================================================================
# Copy this file to .env and configure for your environment
# For production: Use .env.production with stricter security settings

# ===================================================================
# SECURITY CONFIGURATION (REQUIRED FOR PRODUCTION)
# ===================================================================

# Secret key for session management and cryptographic operations
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=change-me-to-a-secure-random-key-in-production

# API keys and authentication tokens
# STRIPE_API_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ===================================================================
# APPLICATION CONFIGURATION
# ===================================================================

# Environment mode: development | staging | production
ENVIRONMENT=development

# Application name and version
APP_NAME=3DprintCAD
APP_VERSION=0.1.0

# Host and port configuration
HOST=0.0.0.0
PORT=5000

# ===================================================================
# FILE UPLOAD CONFIGURATION
# ===================================================================

# Maximum upload file size in MB
MAX_UPLOAD_MB=100

# Maximum batch file processing limit
MAX_BATCH_FILES=20

# Allowed upload MIME types (comma-separated)
ALLOWED_UPLOAD_MIMETYPES=application/sla,model/stl,model/obj,model/3mf

# Upload and results directories
UPLOAD_DIR=./uploads
RESULTS_DIR=./results

# ===================================================================
# PROCESSING CONFIGURATION
# ===================================================================

# Maximum worker threads for parallel processing
MAX_WORKERS=4

# Worker timeout in seconds
WORKER_TIMEOUT_SECONDS=120

# Enable hash manifest enforcement
ENFORCE_HASH_MANIFEST=false

# ===================================================================
# DATABASE CONFIGURATION (Production Only)
# ===================================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/printcad
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10

# ===================================================================
# CACHE CONFIGURATION (Production Only)
# ===================================================================

# REDIS_URL=redis://localhost:6379/0
# CACHE_TYPE=redis
# CACHE_DEFAULT_TIMEOUT=300

# ===================================================================
# LOGGING CONFIGURATION
# ===================================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE_PATH=logs/printcad.log

# Enable structured JSON logging
STRUCTURED_LOGGING=false

# ===================================================================
# COLLABORATION FEATURES
# ===================================================================

# Collaboration API base URL
# PRINTCAD_COLLAB_BASE_URL=https://collab.example.com

# WebSocket endpoint (optional, derived from base URL if not set)
# PRINTCAD_COLLAB_WS_URL=wss://collab.example.com/ws

# ===================================================================
# CDN AND STATIC RESOURCES
# ===================================================================

# CDN resources configuration file
# CDN_RESOURCES_FILE=config/cdn_resources.json

# Enable CDN for static assets
# USE_CDN=false

# ===================================================================
# MONITORING AND OBSERVABILITY
# ===================================================================

# Enable Prometheus metrics endpoint
# ENABLE_METRICS=false

# Metrics port
# METRICS_PORT=9090

# Sentry DSN for error tracking
# SENTRY_DSN=https://...@sentry.io/...

# ===================================================================
# SECURITY HARDENING
# ===================================================================

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Enable CORS (comma-separated allowed origins)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com

# Enable HTTPS redirect
# FORCE_HTTPS=true

# Content Security Policy nonce generation
# CSP_NONCE_ENABLED=true

# ===================================================================
# COMPLIANCE AND AUDIT
# ===================================================================

# Enable audit logging
ENABLE_AUDIT_LOGGING=true

# Audit log encryption key (generate separately)
# AUDIT_ENCRYPTION_KEY=

# Compliance mode: SOC2_TYPE2 | ISO27001 | HIPAA | GDPR
# COMPLIANCE_MODE=SOC2_TYPE2

# ===================================================================
# FEATURE FLAGS
# ===================================================================

# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable AI-powered mesh repair
ENABLE_AI_MESH_REPAIR=false

# Enable topology optimization
ENABLE_TOPOLOGY_OPTIMIZATION=true

# Enable multi-material support
ENABLE_MULTI_MATERIAL=true

# ===================================================================
# INTERNATIONALIZATION
# ===================================================================

# Default language: en | ja | bilingual
DEFAULT_LANGUAGE=en

# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=en,ja

# ===================================================================
# DEVELOPMENT SETTINGS (Do not use in production)
# ===================================================================

# Enable debug mode (NEVER in production)
DEBUG=false

# Enable Flask reloader (development only)
USE_RELOADER=false

# Enable development profiling
ENABLE_PROFILING=false

# ===================================================================
# VALIDATION PARAMETERS
# ===================================================================

# Minimum wall thickness (mm)
MIN_WALL_THICKNESS=0.4

# Minimum feature size (mm)
MIN_FEATURE_SIZE=0.25

# Maximum overhang angle (degrees)
MAX_OVERHANG_ANGLE=45
