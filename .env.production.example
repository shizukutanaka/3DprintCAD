# ===================================================================
# 3D Print CAD Assistant - Production Environment Configuration
# ===================================================================
# SECURITY WARNING: This file contains production security settings
# - Copy to .env.production and configure all values
# - Never commit .env.production to version control
# - Rotate all secrets regularly (minimum every 90 days)
# - Use secrets management service (AWS Secrets Manager, Vault, etc.)
# ===================================================================

# ===================================================================
# CRITICAL SECURITY CONFIGURATION
# ===================================================================

# REQUIRED: Strong secret key (minimum 64 bytes)
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
# ROTATE EVERY 90 DAYS
SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_KEY_MINIMUM_64_BYTES

# REQUIRED: Database credentials
# Use connection pooling and SSL/TLS encryption
DATABASE_URL=postgresql://username:password@db-host:5432/printcad?sslmode=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_SSL_MODE=require

# REQUIRED: Redis cache with authentication
REDIS_URL=redis://:password@redis-host:6379/0
REDIS_SSL=true
REDIS_SSL_CERT_REQS=required

# Payment gateway credentials (if enabled)
# STRIPE_API_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ===================================================================
# PRODUCTION APPLICATION SETTINGS
# ===================================================================

ENVIRONMENT=production
APP_NAME=3DprintCAD
APP_VERSION=0.1.0

# Bind to internal network interface only
HOST=0.0.0.0
PORT=5000

# Force HTTPS and secure cookies
FORCE_HTTPS=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict

# ===================================================================
# STRICT FILE UPLOAD CONTROLS
# ===================================================================

# Conservative upload limits
MAX_UPLOAD_MB=200
MAX_BATCH_FILES=10

# Strict MIME type enforcement
ALLOWED_UPLOAD_MIMETYPES=application/sla,model/stl,model/obj,model/3mf

# Isolated storage with strict permissions (chmod 700)
UPLOAD_DIR=/var/lib/printcad/uploads
RESULTS_DIR=/var/lib/printcad/results

# Enable virus scanning integration
# ENABLE_VIRUS_SCAN=true
# CLAMAV_SOCKET=/var/run/clamav/clamd.ctl

# ===================================================================
# PROCESSING CONFIGURATION
# ===================================================================

# Based on server CPU cores (typically cores - 1)
MAX_WORKERS=8
WORKER_TIMEOUT_SECONDS=180

# REQUIRED: Enforce hash manifest in production
ENFORCE_HASH_MANIFEST=true
HASH_MANIFEST_PATH=/etc/printcad/manifests/production.json

# ===================================================================
# STRICT LOGGING AND AUDIT
# ===================================================================

LOG_LEVEL=WARNING
LOG_FILE_PATH=/var/log/printcad/app.log
STRUCTURED_LOGGING=true

# REQUIRED: Enable audit logging
ENABLE_AUDIT_LOGGING=true
AUDIT_LOG_PATH=/var/log/printcad/audit.log

# REQUIRED: Audit encryption key (store in secrets manager)
AUDIT_ENCRYPTION_KEY=REPLACE_WITH_256_BIT_ENCRYPTION_KEY

# Log retention (days)
LOG_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=2555  # 7 years for compliance

# Forward logs to SIEM
SYSLOG_HOST=siem.example.com
SYSLOG_PORT=514
SYSLOG_PROTOCOL=TLS

# ===================================================================
# COMPLIANCE CONFIGURATION
# ===================================================================

# Compliance framework: SOC2_TYPE2 | ISO27001 | HIPAA | GDPR
COMPLIANCE_MODE=SOC2_TYPE2

# Enable compliance reporting
COMPLIANCE_REPORTING=true
COMPLIANCE_OFFICER_EMAIL=security@example.com

# Data retention policy enforcement
ENABLE_DATA_RETENTION_POLICY=true

# ===================================================================
# SECURITY HARDENING
# ===================================================================

# Strict rate limiting
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=50

# IP-based rate limiting
ENABLE_IP_RATE_LIMITING=true

# CORS configuration (strict whitelist)
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://app.example.com,https://console.example.com

# Content Security Policy
CSP_NONCE_ENABLED=true
CSP_REPORT_URI=https://csp-reports.example.com

# Security headers
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Enable Web Application Firewall integration
# WAF_ENABLED=true

# ===================================================================
# MONITORING AND OBSERVABILITY
# ===================================================================

# REQUIRED: Enable metrics for production monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Prometheus pushgateway
# PROMETHEUS_PUSHGATEWAY=http://pushgateway:9091

# REQUIRED: Error tracking and alerting
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Health check endpoints
ENABLE_HEALTH_CHECK=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready

# Application Performance Monitoring
# APM_SERVICE_NAME=printcad-production
# APM_SERVER_URL=https://apm.example.com

# ===================================================================
# CDN AND STATIC ASSETS
# ===================================================================

# REQUIRED: Use CDN in production
USE_CDN=true
CDN_RESOURCES_FILE=/etc/printcad/config/cdn_resources.json

# Static asset CDN
STATIC_CDN_URL=https://cdn.example.com/printcad

# Enable Subresource Integrity (SRI)
ENABLE_SRI=true

# ===================================================================
# COLLABORATION SERVICES
# ===================================================================

# Production collaboration endpoints
PRINTCAD_COLLAB_BASE_URL=https://collab.example.com
PRINTCAD_COLLAB_WS_URL=wss://collab.example.com/ws

# API authentication
COLLAB_API_KEY=REPLACE_WITH_SECURE_API_KEY
COLLAB_API_SECRET=REPLACE_WITH_SECURE_API_SECRET

# ===================================================================
# DISASTER RECOVERY AND BACKUP
# ===================================================================

# Enable automated backups
ENABLE_AUTOMATED_BACKUP=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Backup storage location
BACKUP_S3_BUCKET=printcad-backups-prod
BACKUP_S3_REGION=us-east-1
BACKUP_ENCRYPTION=AES256

# Point-in-time recovery
ENABLE_PITR=true

# ===================================================================
# FEATURE FLAGS (Production)
# ===================================================================

# Disable experimental features in production
ENABLE_EXPERIMENTAL_FEATURES=false

# AI features (enable only when validated)
ENABLE_AI_MESH_REPAIR=false
ENABLE_TOPOLOGY_OPTIMIZATION=true
ENABLE_MULTI_MATERIAL=true

# ===================================================================
# INTERNATIONALIZATION
# ===================================================================

DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ja

# Localization cache
ENABLE_I18N_CACHE=true

# ===================================================================
# PERFORMANCE OPTIMIZATION
# ===================================================================

# Enable production caching
CACHE_TYPE=redis
CACHE_DEFAULT_TIMEOUT=600
CACHE_KEY_PREFIX=printcad:prod:

# Database query caching
ENABLE_QUERY_CACHE=true
QUERY_CACHE_SIZE=1000

# Enable CDN caching headers
CDN_CACHE_MAX_AGE=31536000

# Compression
COMPRESS_RESPONSES=true
COMPRESS_LEVEL=6

# ===================================================================
# NETWORK AND INFRASTRUCTURE
# ===================================================================

# Reverse proxy configuration
TRUST_PROXY_HEADERS=true
PROXY_COUNT=1

# DNS resolver
# DNS_SERVER=8.8.8.8,8.8.4.4

# Timeout settings
REQUEST_TIMEOUT=30
KEEPALIVE_TIMEOUT=5

# ===================================================================
# VALIDATION PARAMETERS
# ===================================================================

MIN_WALL_THICKNESS=0.4
MIN_FEATURE_SIZE=0.25
MAX_OVERHANG_ANGLE=45

# ===================================================================
# PRODUCTION SAFETY CHECKS
# ===================================================================

# NEVER enable these in production
DEBUG=false
USE_RELOADER=false
ENABLE_PROFILING=false
TESTING=false

# ===================================================================
# EXTERNAL SERVICE INTEGRATIONS
# ===================================================================

# Email service (for notifications and alerts)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=notifications@example.com
# SMTP_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Notification emails
# ADMIN_EMAIL=admin@example.com
# SECURITY_EMAIL=security@example.com
# OPERATIONS_EMAIL=ops@example.com

# ===================================================================
# KUBERNETES/CONTAINER SPECIFIC
# ===================================================================

# Service mesh configuration
# ENABLE_SERVICE_MESH=true
# MESH_TYPE=istio

# Pod configuration
# POD_NAME=${HOSTNAME}
# POD_NAMESPACE=printcad-production
# POD_IP=${POD_IP}

# Graceful shutdown
GRACEFUL_SHUTDOWN_TIMEOUT=30

# ===================================================================
# SECURITY REMINDERS
# ===================================================================
# 1. Rotate all secrets every 90 days minimum
# 2. Use secrets management service (not environment files)
# 3. Enable audit logging and forward to SIEM
# 4. Review access logs daily
# 5. Implement automated security scanning
# 6. Test disaster recovery procedures monthly
# 7. Maintain incident response runbooks
# 8. Keep all dependencies updated
# 9. Conduct regular security assessments
# 10. Document all configuration changes
# ===================================================================
